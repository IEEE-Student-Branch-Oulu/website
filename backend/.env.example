# Copy to `.env` and adjust for your environment.
# `.env` is git-ignored; never commit secrets.

# Database (asyncpg URL — matches docker-compose default).
DATABASE_URL=postgresql+asyncpg://ieee:ieee@localhost:5432/ieee

# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# dev | test | prod
ENV=dev

# Placeholder for future auth — replace before shipping anything that uses it.
AUTH_SECRET_KEY=change-me
