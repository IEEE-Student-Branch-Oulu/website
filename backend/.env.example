# Copy to `.env` and adjust for your environment.
# `.env` is git-ignored; never commit secrets.

# dev | test | prod
ENV=dev

# Database (asyncpg URL — matches docker-compose default).
DATABASE_URL=postgresql+asyncpg://ieee:ieee@localhost:5432/ieee

# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# Auth
AUTH_SECRET_KEY=change-me

# Email — "console" logs to stdout (default), "resend" uses Resend SDK, "memory" for tests.
EMAIL_BACKEND=console
EMAIL_FROM=IEEE SB Oulu <noreply@ieee-oulu.fi>
# EMAIL_RESEND_API_KEY=re_...  # Required when EMAIL_BACKEND=resend

# Public-facing URL (used in email links)
PUBLIC_BASE_URL=http://localhost:3000
